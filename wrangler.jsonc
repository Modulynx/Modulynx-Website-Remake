{
  // Cloudflare's newer dashboard routes static sites through Workers rather
  // than Pages. This describes the site for that path: no server code, just
  // the built directory served as static assets.
  //
  // Pages does not read this file — it takes the build command and output
  // directory from its own settings — so keeping it costs nothing there.
  "name": "modulynx",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./dist",
    // One page, no routes: anything unmatched should still land on the story
    // rather than a bare error.
    "not_found_handling": "single-page-application"
  }
}
